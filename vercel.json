{
  "root": "artifacts/pepebull",
  "buildCommand": "cd ../../ && pnpm --filter pepebull build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "installCommand": "cd ../../ && pnpm install",
  "env": {
    "PORT": "3000",
    "BASE_PATH": "/"
  },
  "env.production": {
    "PORT": "3000",
    "BASE_PATH": "/"
  }
}
